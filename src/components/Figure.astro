---
const {
  src,
  alt,
  caption,
  width = "100%",
} = Astro.props;
---

<figure class="figure">
  <img src={src} alt={alt} style={`width: ${width};`} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .figure {
    margin: 2rem 0;
  }

  .figure img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: #666;
    text-align: center;
  }
</style>